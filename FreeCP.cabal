name:                FreeCP
version:             0.1
synopsis:            A Type Checker for FreeCP
description:         Supplemental artifact for ECOOP submission
homepage:
license:             MIT
license-file:        LICENSE
author:              ANONYMOUS
maintainer:          ANONY@MOUS
copyright:           (c) 2026 ANONYMOUS
category:            Language
build-type:          Simple
extra-source-files:  Makefile
extra-doc-files:     ChangeLog.md,
                     README.md
cabal-version:       1.18

executable freecp
  main-is:           Main.hs

  other-modules:     Common,
                     Atoms,
                     Measure,
                     Type,
                     Process,
                     Resolver,
                     Parser,
                     Lexer,
                     Instrumenter,
                     Checker,
                     Solver,
                     Render,
                     Exceptions
  other-extensions:  CPP

  build-depends:     base >=4.9 && <4.19,
                     containers >=0.6 && <0.8,
                     mtl >=2.2 && <2.4,
                     array >=0.5 && <0.6,
                     time >=1.5 && <1.13,
                     filepath >=1.4 && <1.5,
                     prettyprinter >=1.0 && <1.8,
                     prettyprinter-ansi-terminal >=1.0 && <1.2,
                     random >=1.2.1 && <1.3,
                     limp >=0.3.2.3 && <0.4,
                     data-partition >=0.3 && <0.4

  hs-source-dirs:    src
  build-tools:       alex, happy
  default-language:  Haskell2010
